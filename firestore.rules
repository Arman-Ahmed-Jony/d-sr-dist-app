rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return signedIn() && userDoc().active == true;
    }

    function role() {
      return userDoc().role;
    }

    function distributorId() {
      return userDoc().distributorId;
    }

    function sameDistributor(distId) {
      return isActiveUser() && distId == distributorId();
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (isActiveUser()
          && role() == 'distributor'
          && resource.data.distributorId == distributorId())
      );
      allow create: if signedIn() && (
        request.auth.uid == userId ||
        (
          isActiveUser()
          && role() == 'distributor'
          && request.resource.data.role == 'sr'
          && request.resource.data.distributorId == distributorId()
        )
      );
      allow update: if isActiveUser() && (
        request.auth.uid == userId ||
        (role() == 'distributor' && resource.data.distributorId == distributorId())
      );
    }

    match /distributors/{distId} {
      allow read: if sameDistributor(distId);
      allow write: if false;
    }
  }
}
