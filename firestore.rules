rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return signedIn() && userDoc().active == true;
    }

    function role() {
      return userDoc().role;
    }

    function distributorId() {
      return userDoc().distributorId;
    }

    function sameDistributor(distId) {
      return isActiveUser() && distId == distributorId();
    }

    function immutableIdentity() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.distributorId == resource.data.distributorId
        && request.resource.data.email == resource.data.email;
    }

    function onlyNameActiveUpdated() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'active', 'updatedAt']);
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId ||
        (isActiveUser()
          && role() == 'distributor'
          && resource.data.distributorId == distributorId())
      );
      allow create: if signedIn() && (
        request.auth.uid == userId ||
        (
          isActiveUser()
          && role() == 'distributor'
          && request.resource.data.role == 'sr'
          && request.resource.data.distributorId == distributorId()
        )
      );
      allow update: if isActiveUser()
        && immutableIdentity()
        && (
          (
            request.auth.uid == userId
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'updatedAt'])
          )
          || (
            role() == 'distributor'
            && resource.data.distributorId == distributorId()
            && resource.data.role == 'sr'
            && onlyNameActiveUpdated()
          )
        );
    }

    match /distributors/{distId} {
      allow read: if sameDistributor(distId);
      allow write: if false;
    }
  }
}
